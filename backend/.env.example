# Секрет для подписи JWT (в продакшене — длинная случайная строка)
SECRET_KEY=replace-with-long-random-string
# Строка подключения: SQLite (разработка) или PostgreSQL + asyncpg, см. docker-compose.yml
DATABASE_URL=sqlite:///./todo.db
# DATABASE_URL=postgresql://todo:todo@localhost:5432/todo
# Создавать таблицы при старте (в продакшене — false, только Alembic)
AUTO_CREATE_TABLES=true
# Срок жизни токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Опционально: токен Logfire (https://logfire.pydantic.dev)
# LOGFIRE_TOKEN=
